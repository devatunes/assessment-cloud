# Copia este archivo a .env para desarrollo local (valores del docker-compose)
NODE_ENV=development
PORT=3000

# Base de datos (docker compose expone Postgres en 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=assessment
DB_PASSWORD=assessment_local_dev
DB_NAME=assessment
DB_SSL=false
DB_MIGRATIONS_RUN=true

# CORS: origen del frontend Angular local
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Ejecución de código: "local" usa el runner en ../executor, "lambda" invoca la Lambda executor
EXECUTOR_MODE=local
EXECUTOR_FUNCTION_NAME=

# Auth de organización (staff que recluta) — secreto propio
JWT_SECRET=assessment-cloud-secret-dev
JWT_EXPIRES_IN=8h
JWT_ISSUER=assessment-cloud-api
JWT_AUDIENCE=assessment-cloud-org
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15

# Auth de candidatos (sistema de cuentas separado, misma llave pero audience distinto)
CANDIDATE_JWT_AUDIENCE=assessment-cloud-candidates

# Admin que se crea automáticamente en la "Organización por defecto" al
# arrancar, para poder ver la data ya sembrada (SeedQuestions)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
