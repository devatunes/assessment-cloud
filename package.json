{
  "name": "assessment-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de assessments técnicos — kata Fullstack/Cloud",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose up -d db",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm start",
    "test:executor": "cd executor && node test-local.js",
    "test:backend": "cd backend && npm test",
    "test:backend:e2e": "cd backend && npm run test:e2e",
    "test": "npm run test:executor && npm run test:backend && npm run test:backend:e2e",
    "deploy:back": "./deploy-backend.sh",
    "deploy:executor": "./deploy-executor.sh",
    "deploy:front": "./deploy-frontend.sh",
    "deploy:all": "npm run deploy:back && npm run deploy:executor && npm run deploy:front",
    "plan:iac": "cd ../app-iac && terraform plan -var-file=terraform.tfvars -target=module.assessment_frontend -target=module.assessment_database -target=module.assessment_backend",
    "deploy:iac": "cd ../app-iac && terraform apply -var-file=terraform.tfvars -target=module.assessment_frontend -target=module.assessment_database -target=module.assessment_backend"
  }
}
